          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', () => pm.response.to.be.success);",
                  "pm.test('success is true', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.test('role is CombinedChildParent', () => pm.expect(pm.response.json().user.role).to.eql('CombinedChildParent'));",
